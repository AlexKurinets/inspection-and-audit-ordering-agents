# Host ports. Change any that are taken on your machine.
POSTGRES_PORT=5474
API_PORT=8140
SIM_PORT=8141
DASHBOARD_PORT=8540

# offline uses the deterministic stand-in; claude calls the Anthropic API and needs a key.
LLM_PROVIDER=offline
ANTHROPIC_API_KEY=
OPS_LLM_MODEL=claude-opus-5-5

# role:token pairs for resolving exceptions. Replace these outside a local demo.
ROLE_TOKENS=audit_reviewer:demo-audit-reviewer,underwriter:demo-underwriter,ops_lead:demo-ops-lead
